{
  "name": "crm",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- node --import ./instrument.server.mjs ./node_modules/vite/bin/vite.js dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:types": "dotenv -e .env.local -- sh -c 'mkdir -p src/types && { supabase gen types --lang typescript --project-id skygtamcakhoirlrqlnq --schema public > src/types/database.ts.tmp || { rm -f src/types/database.ts.tmp; exit 1; }; } && mv src/types/database.ts.tmp src/types/database.ts' && prettier --write src/types/database.ts",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "geocode:backfill": "dotenv -e .env.local -- node --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs scripts/geocode-backfill.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@sentry/tanstackstart-react": "^10.67.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/query-db-collection": "^1.2.15",
    "@tanstack/react-db": "^0.4.1",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.59",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/store": "^0.11.1",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/tanstack-react": "10.6.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "storybook": "10.6.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
