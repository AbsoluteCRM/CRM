# Supabase project settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: only needed for privileged server-side operations (bypasses RLS).
# Supabase project settings > API > service_role secret. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ char secret used to hash visitor IPs for the public portal rate limit
PORTAL_IP_HMAC_KEY=

# Optional: Google Maps Embed API key (restrict by HTTP referrer). Without it the
# calendar's stop maps show a placeholder.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: only needed by `pnpm db:types` if you haven't run `supabase login`.
# Prefer `supabase login`: this is an account-wide personal access token.
# SUPABASE_ACCESS_TOKEN=
