# Supabase project settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: only needed for privileged server-side operations (bypasses RLS).
# Supabase project settings > API > service_role secret. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ char secret used to hash visitor IPs for the public portal rate limit
PORTAL_IP_HMAC_KEY=

# Optional: basemap tiles for the OpenLayers maps (ADR 0014).
# VITE_MAP_PROVIDER is maptiler, stadia, or osm. Unset, it is maptiler when a key
# is set, OpenStreetMap in dev, and no basemap in production builds. OSM's public
# tiles are for development only. The key ships to the browser, so restrict it by
# HTTP origin in the provider's console. Stadia can use domain auth instead of a key.
VITE_MAP_PROVIDER=
VITE_MAP_API_KEY=
# Optional: only needed by `pnpm db:types` if you haven't run `supabase login`.
# Prefer `supabase login`: this is an account-wide personal access token.
# SUPABASE_ACCESS_TOKEN=

# Team invitation email (server only)
RESEND_API_KEY=

# Production sender: requests@terraformaflow.com
RESEND_FROM_EMAIL=
SERVER_URL=

# SERVER_URL: https://terraformaflow.com in production; http://localhost:3000 locally

# Weather API key
WEATHER_API_KEY=

# Geocoding (server only). Property addresses are geocoded on save and stored.
# MapTiler Cloud key used only server-side for the Geocoding API (separate from
# any public map-tile key; restrict it to the Geocoding API).
MAPTILER_API_KEY=
# Comma-separated provider order. Default: maptiler. `nominatim` (public OSM,
# 1 req/s) is for dev and the backfill script only; it is ignored in production.
# GEOCODER_CHAIN=maptiler,nominatim
# Identifying User-Agent for Nominatim, per its usage policy (include a contact).
# NOMINATIM_USER_AGENT=AbsoluteCRM/0.1 (+https://github.com/AbsoluteCRM/CRM; you@example.com)
