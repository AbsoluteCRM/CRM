# Postgres connection string (Supabase project settings > Database > Connection string > URI).
# Use the pooled ("Transaction" mode, port 6543) connection for the app; use the
# direct (port 5432) connection when running `pnpm db:migrate`.
DATABASE_URL=

# Supabase project settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: only needed for privileged server-side operations (bypasses RLS).
# Supabase project settings > API > service_role secret. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
